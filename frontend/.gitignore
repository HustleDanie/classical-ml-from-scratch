# Synced content (regenerated by scripts/sync-content.mjs).
# Use `content/*` (not `content/`) so the `!content/learn/...` re-include
# rules below can take effect — git won't descend into a fully-ignored dir.
public/plots/
content/*
# …except for /learn, which is hand-written and not derived from the
# parent repo. The sync script preserves it; git must track it.
!content/learn/
!content/learn/**
